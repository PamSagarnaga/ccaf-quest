# ── Supabase ──────────────────────────────────────────────
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key — server-only, NEVER exposed to the browser.
# Used by the seed script (scripts/seed.ts) to bypass RLS when loading content.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Anthropic (Phase 6: live "Ask Claude" explanations) ───
# Server-only. The Next.js route handler proxies calls so this key
# is never shipped to the client. Leave blank until Phase 6.
ANTHROPIC_API_KEY=
